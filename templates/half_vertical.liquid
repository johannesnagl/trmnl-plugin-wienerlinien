{% assign monitors = data.monitors %}
{% assign server_time = message.serverTime | split: 'T' | last | slice: 0, 5 %}

<div class="layout layout--col">

  {% if monitors.size == 0 %}
    <div class="layout layout--col layout--center">
      <div class="title">No departures</div>
      <div class="label text--gray-45">Check RBL numbers.</div>
    </div>
  {% endif %}

  {% for m in monitors limit:4 %}
    {% assign stop_name = m.locationStop.properties.title %}
    {% for line in m.lines limit:1 %}
      <div>
        <table style="width: 100%; table-layout: fixed">
          <colgroup>
            <col style="width: 28%">
            <col>
          </colgroup>
          <tr>
            <td>
              <div class="value value--large" data-value-fit="true">{{ line.name }}</div>
            </td>
            <td>
              <div class="value value--xsmall" data-value-fit="true">→ {{ line.towards | truncate: 22 }}</div>
              <div class="label text--gray-45">{{ stop_name | truncate: 22 }}</div>
            </td>
          </tr>
        </table>
        <table style="width: 100%; table-layout: fixed">
          <tr>
            {% for dep in line.departures.departure limit:3 %}
              {% assign t = dep.departureTime.timeReal | default: dep.departureTime.timePlanned %}
              {% assign hhmm = t | split: 'T' | last | slice: 0, 5 %}
              <td class="text--center">
                <div class="value value--medium" data-value-fit="true">{{ hhmm }}</div>
              </td>
            {% endfor %}
          </tr>
        </table>
      </div>
    {% endfor %}
  {% endfor %}

</div>

<div class="title_bar">
  <span class="title">Abfahrtsmonitor</span>
  <span class="instance">as of {{ server_time }}</span>
</div>
